{
  "name": "rnvideochat",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "clean:watchman": "watchman watch-del '.'; watchman watch-project '.'",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "codegen:ios": "cd ios & bundle install & bundle exec pod install"
  },
  "codegenConfig": {
    "name": "NativeLocalStorageSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.nativelocalstorage"
    },
    "ios": {
      "modulesProvider": {
        "NativeLocalStorage": "RCTNativeLocalStorage"
      }
    }
  },
  "dependencies": {
    "@connectycube/react": "^5.0.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^23.5.0",
    "@react-native-firebase/messaging": "^23.5.0",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "@reduxjs/toolkit": "^2.10.1",
    "lucide-react-native": "^0.553.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-callkeep": "^4.3.16",
    "react-native-device-info": "^15.0.1",
    "react-native-incall-manager": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-simple-toast": "^3.3.2",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.0",
    "react-native-voip-push-notification": "^3.3.3",
    "react-native-webrtc": "^124.0.7",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
